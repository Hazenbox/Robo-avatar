{
  "name": "zoro-avatar",
  "version": "0.1.0",
  "description": "A face for your AI: a small animated robot that shows what your product is doing. Drawn in Canvas 2D and WebGL2, with no images, no Lottie and no dependencies.",
  "author": "Upen (https://www.linkedin.com/in/upen-design/)",
  "keywords": ["ai", "chatbot", "assistant", "avatar", "mascot", "robot", "loading", "animation", "canvas", "webgl", "react", "ui"],
  "license": "MIT",
  "type": "module",
  "repository": { "type": "git", "url": "git+https://github.com/Hazenbox/Zoro-avatar.git", "directory": "zoro" },
  "bugs": { "url": "https://github.com/Hazenbox/Zoro-avatar/issues" },
  "homepage": "https://github.com/Hazenbox/Zoro-avatar#readme",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./react": { "types": "./dist/react.d.ts", "import": "./dist/react.js" },
    "./package.json": "./package.json"
  },
  "files": ["dist", "LICENSE", "README.md"],
  "scripts": {
    "dev": "vite --config playground/vite.config.ts",
    "build": "tsup",
    "build:playground": "vite build --config playground/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test && npm run build && npm run build:playground",
    "prepublishOnly": "npm run check"
  },
  "peerDependencies": { "react": ">=18" },
  "peerDependenciesMeta": { "react": { "optional": true } },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
